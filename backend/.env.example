PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gatherix
JWT_SECRET=replace_with_a_long_random_secret
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP settings for signup welcome emails. Gmail requires a Google App Password,
# not your regular account password. Use the same address in EMAIL_USER and EMAIL_FROM.
# Port 465 uses EMAIL_SECURE=true; port 587 uses EMAIL_SECURE=false.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Gatherix <your_email_address>"
